{
  "name": "qrdrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config vite.mobile.config.ts",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "codeintel": "node tools/codeintel/cli.mjs",
    "test:codeintel": "node --test tools/codeintel/codeintel.test.mjs",
    "test:hash": "node --test tools/tests/sha256.test.mjs",
    "test:hash:large": "node tools/tests/sha256-large.mjs",
    "test:mobile": "node tools/tests/mobile-api.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
