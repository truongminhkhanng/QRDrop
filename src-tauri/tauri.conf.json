{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QRDrop", "version": "0.1.0", "identifier": "app.qrdrop.desktop",
  "build": { "beforeDevCommand": "npm run build", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "QRDrop", "width": 820, "height": 780, "minWidth": 600, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true, "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Nhận tệp từ điện thoại qua mạng nội bộ",
    "category": "Utility",
    "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist" },
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "offlineInstaller" } }
  }
}
